{
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://edusure-backend.onrender.com/api/:path*/"
    },
    {
      "source": "/media/:path*",
      "destination": "https://edusure-backend.onrender.com/media/:path*"
    },
    {
      "source": "/admin-portal",
      "destination": "/admin-portal.html"
    },
    {
      "source": "/admin-portal/:path*",
      "destination": "/admin-portal.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}